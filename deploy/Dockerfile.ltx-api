# ltx-api container (no torch / no GPU). Build from monorepo root:
#   docker build -f deploy/Dockerfile.ltx-api -t ltx-api:latest .
FROM python:3.12-slim-bookworm

WORKDIR /app

COPY packages/ltx-api /app/packages/ltx-api

RUN pip install --no-cache-dir "/app/packages/ltx-api"

ENV LTX_API_HOST=0.0.0.0
ENV LTX_API_PORT=8080
EXPOSE 8080

CMD ["python", "-m", "uvicorn", "ltx_api.main:create_app_instance", "--factory", "--host", "0.0.0.0", "--port", "8080"]
