# =============================================================================
# Docker Compose only (not read by ltx-api Python)
# Used by deploy/docker-compose.yml and deploy/docker-compose.gcp.yml
# =============================================================================

# Host port published to the VM (container still listens on 8080 inside).
LTX_PUBLISH_PORT=8080

# Image built by Cloud Build (deploy/cloudbuild.yaml) and pushed to Artifact Registry.
# VM / laptop with docker-compose.gcp.yml: set this and use pull only — no docker build.
# Example: northamerica-south1-docker.pkg.dev/PROJECT_ID/ltx-docker/ltx-api:latest
LTX_DOCKER_IMAGE=

# =============================================================================
# ltx-api — env prefix LTX_API_ (see packages/ltx-api/src/ltx_api/config.py)
# =============================================================================

# --- Bind address / port (optional in deploy images: Dockerfile CMD fixes uvicorn
#     to 0.0.0.0:8080; these matter for local `uv run` / custom images) ---
# LTX_API_HOST=0.0.0.0
# LTX_API_PORT=8080
# Global debug logging (ltx_api + httpx/httpcore). Use only while troubleshooting.
# LTX_API_DEBUG=1

# Bearer token for Authorization: Bearer … Empty = auth disabled.
LTX_API_AUTH_TOKEN=

# mock = canned MP4 (dev/tests). real = PyTorch on this same process (needs [real]).
# vastai = forward inference to ltx-gpu-worker (HTTP); API may rent Vast instances.
LTX_API_INFERENCE_BACKEND=vastai

# Base URL returned in upload responses (no trailing slash). Must match how clients reach this host.
LTX_API_PUBLIC_BASE_URL=https://your-vm.example.com

# Uploaded assets + job scratch space. Compose mounts a volume at /data/ltx-api-storage.
LTX_API_STORAGE_DIR=/data/ltx-api-storage

# Max parallel async jobs (in-memory queue; default 1).
# LTX_API_MAX_CONCURRENT_JOBS=1

# Seconds before async job records expire from memory (default 3600).
# LTX_API_JOB_TTL_SECONDS=3600

# --- Real backend only (LTX_API_INFERENCE_BACKEND=real; not used in slim ltx-api Docker image) ---
# Distilled (fast / ltx-2-3-fast):
# LTX_API_CHECKPOINT_PATH=/path/to/ltx-2.3-22b-distilled.safetensors
# LTX_API_SPATIAL_UPSAMPLER_PATH=/path/to/ltx-2.3-spatial-upscaler-x2-1.0.safetensors
# Pro / one-stage (ltx-2-3-pro): either set LTX_API_WORKER_PIPELINE=full and LTX_API_CHECKPOINT_PATH to dev .safetensors,
# or use both mode:
# LTX_API_WORKER_PIPELINE=both
# LTX_API_CHECKPOINT_PATH=/path/to/ltx-2.3-22b-distilled.safetensors
# LTX_API_FULL_CHECKPOINT_PATH=/path/to/ltx-2.3-22b-dev.safetensors
# LTX_API_GEMMA_ROOT=/path/to/gemma-3-12b-it-qat-q4_0-unquantized

# --- Vast.ai + GPU worker (LTX_API_INFERENCE_BACKEND=vastai) ---

# If set, skip Vast create/destroy and POST inference here (public worker URL, port mapped).
# Empty = auto-provision instances with LTX_API_VAST_API_KEY.
# LTX_API_VAST_WORKER_BASE_URL=http://1.2.3.4:8765

# Vast REST API origin (Bearer auth).
LTX_API_VAST_API_BASE=https://console.vast.ai

# Required when LTX_API_VAST_WORKER_BASE_URL is empty (auto-provision). Bearer for Vast API.
LTX_API_VAST_API_KEY=

# SSH key path on the API host (optional; for scripts that SSH to workers — not used for HTTP forward).
# LTX_API_VAST_SSH_KEY_PATH=/home/you/.ssh/id_ed25519

# Bundle search / create: minimum GPU VRAM (MiB), GPU name filter, disk sizes (GB).
LTX_API_VAST_GPU_RAM_MB=80000
LTX_API_VAST_GPU_NAME=A100_SXM4
LTX_API_VAST_DISK_GB=200
LTX_API_VAST_DISK_SEARCH_GB=100
# When using template_hash_id, disk is omitted from the create request unless true (avoids invalid_args if disk > offer max).
# LTX_API_VAST_TEMPLATE_SEND_DISK=1
# Debug-only: log raw Vast create_instance request/response payload in API logs.
# LTX_API_VAST_DEBUG_LOG_PAYLOAD=1

# GPU worker image (when using image-based create — build deploy/Dockerfile.ltx-gpu-worker, push to a registry Vast can pull):
# LTX_API_VAST_IMAGE=your-dockerhub-user/ltx-gpu-worker:latest

# Instance image: Vast template hash (preferred) or docker image if hash empty.
# HTTP 400 invalid_args with template: do not mix ad-hoc runtype with template_hash_id (handled in ltx-api). Stale offer is retried automatically.
# If Vast says "invalid template hash ... not accessible by user", the hash is not visible to your API key — create/save a template in the Vast UI for this account, or set hash empty and use LTX_API_VAST_IMAGE.
# HTTP 400 on /asks/{id}/ can also mean bad template for that host — use a hash from Vast UI, or set empty to use image only:
# LTX_API_VAST_TEMPLATE_HASH_ID=
LTX_API_VAST_TEMPLATE_HASH_ID=aa3bf4890de6b073eec0a2b89f1a82f2
# LTX_API_VAST_IMAGE=vastai/base-image:@vastai-automatic-tag

# Label on created instances (find/destroy by label).
LTX_API_VAST_LABEL=ltx-api-gpu-worker

# Comma-separated country codes; tried first when searching bundles.
LTX_API_VAST_GEOLOCATION_PREFERRED=US

# Container port the GPU worker listens on; must match Vast port map → public HostPort.
LTX_API_VAST_WORKER_INTERNAL_PORT=8765

# After this many seconds with no inference, delete auto-provisioned instance (ignored for fixed worker URL).
LTX_API_VAST_IDLE_TIMEOUT_SECONDS=900

# Poll interval (seconds) while waiting for instance/worker to become ready.
# LTX_API_VAST_POLL_INTERVAL_SECONDS=15

# HTTP client timeout (seconds) for worker inference requests.
LTX_API_VAST_HTTP_TIMEOUT_SECONDS=1200

# After /health succeeds, poll GET /ready on the worker and log readiness changes (default on).
# LTX_API_VAST_WORKER_POLL_READY=0
# If true, error if /ready never reports ready=true within LTX_API_VAST_WORKER_READY_TIMEOUT_SECONDS (use with LTX_WORKER_PREWARM on GPU host).
# LTX_API_VAST_WORKER_WAIT_FOR_PIPELINE_READY=1
# Seconds to poll /ready after /health (default 300).
# LTX_API_VAST_WORKER_READY_TIMEOUT_SECONDS=300

# =============================================================================
# ltx-gpu-worker on the GPU machine only (omit on GCP ltx-api VM)
# See packages/ltx-api/src/ltx_api/worker/server.py — not LTX_API_* settings.
# =============================================================================
# LTX_WORKER_HOST=0.0.0.0
# LTX_WORKER_PORT=8765
# Background-load DistilledPipeline so /ready becomes true before first inference (recommended with WAIT_FOR_PIPELINE_READY).
# LTX_WORKER_PREWARM=1
# distilled = fast only; full = pro only; both = dev+distilled+upsampler (LTX Desktop fast+pro).
# LTX_API_WORKER_PIPELINE=distilled
# LTX_API_WORKER_PIPELINE=full
# LTX_API_WORKER_PIPELINE=both
# Camera LoRAs (docker-entrypoint): default download under /models/ltx-2-19b-lora-camera-control; skip with:
# LTX_SKIP_CAMERA_LORAS=1
# LTX_CAMERA_LORA_DIR=/models/ltx-2-19b-lora-camera-control
